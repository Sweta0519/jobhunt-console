# Vercel and local. The anon key is safe in the browser; RLS does the work.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Workers and the one-time import ONLY. Never set these on Vercel: the service
# role key bypasses row level security across the whole Supabase project.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
